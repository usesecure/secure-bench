{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/schemas/phase27-case-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "pair_id", "label", "family_id", "framework", "source_format", "topology", "orientation", "adversarial_variant", "fixture_ticket", "source_files", "exact_fingerprint", "normalized_fingerprint", "evidence_contract_v2"],
  "properties": {
    "schema_version": {"const": "secure-bench-phase27-case-v2"},
    "case_id": {"type": "string", "pattern": "^aurora-[0-9a-f]{18}$"},
    "pair_id": {"type": "string", "pattern": "^orbit-se100[1-7]-[0-9a-f]{14}$"},
    "label": {"enum": ["vulnerable", "control"]},
    "family_id": {"enum": ["SE1001", "SE1002", "SE1003", "SE1004", "SE1005", "SE1006", "SE1007"]},
    "framework": {"enum": ["node", "express", "next-app-router", "server-actions"]},
    "source_format": {"enum": ["javascript", "jsx", "typescript", "tsx"]},
    "topology": {"enum": ["direct", "helper-mediated", "inter-file-aliased", "control-flow-sensitive"]},
    "orientation": {"enum": ["vulnerable-first", "control-first"]},
    "adversarial_variant": {"type": "string"},
    "fixture_ticket": {"type": "string"},
    "source_files": {"type": "array", "minItems": 1, "maxItems": 2},
    "exact_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_contract_v2": {"type": "object"}
  }
}
