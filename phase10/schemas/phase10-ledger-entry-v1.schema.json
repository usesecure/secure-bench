{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/schemas/phase10-ledger-entry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event", "holdout_id", "run_id", "manifest_sha256", "evidence_contract_sha256", "taxonomy_sha256", "aggregate_corpus_sha256", "commitment_root", "binary_sha256", "previous_entry_hash", "timestamp_utc", "case_id", "case_status", "process_status", "case_record_sha256", "report_sha256", "isolation_sha256", "result_sha256", "failure_code", "entry_hash"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase10-ledger-entry-v1" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 226 },
    "event": { "enum": ["execution_started", "case_recorded", "execution_completed", "execution_failed"] },
    "holdout_id": { "const": "phase-9-orthogonal-holdout-v3" },
    "run_id": { "const": "secure-engine-0-1-4-phase9-holdout-once" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_contract_sha256": { "$ref": "#/$defs/sha256" },
    "taxonomy_sha256": { "$ref": "#/$defs/sha256" },
    "aggregate_corpus_sha256": { "$ref": "#/$defs/sha256" },
    "commitment_root": { "$ref": "#/$defs/sha256" },
    "binary_sha256": { "$ref": "#/$defs/sha256" },
    "previous_entry_hash": { "$ref": "#/$defs/sha256" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "case_id": { "type": ["string", "null"] },
    "case_status": { "type": ["string", "null"] },
    "process_status": { "type": ["string", "null"] },
    "case_record_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "report_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "isolation_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "result_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "failure_code": { "type": ["string", "null"] },
    "entry_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  }
}
