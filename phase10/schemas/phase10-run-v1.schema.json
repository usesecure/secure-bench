{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/schemas/phase10-run-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "holdout_id", "pre_execution_contract_sha256", "binary_sha256", "source_rpm_sha256", "command_template", "process_status_policy_version", "ai_validation", "version_probe_executed", "host", "started_unix_ms", "finished_unix_ms", "status", "case_journal_sha256", "scanner_launch_attempts", "scanner_processes_attested", "cases"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase10-run-v1" },
    "run_id": { "const": "secure-engine-0-1-4-phase9-holdout-once" },
    "holdout_id": { "const": "phase-9-orthogonal-holdout-v3" },
    "pre_execution_contract_sha256": { "$ref": "#/$defs/sha256" },
    "binary_sha256": { "$ref": "#/$defs/sha256" },
    "source_rpm_sha256": { "$ref": "#/$defs/sha256" },
    "command_template": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } },
    "process_status_policy_version": { "const": "1.0.0" },
    "ai_validation": { "type": "string", "pattern": "^disabled" },
    "version_probe_executed": { "const": false },
    "host": { "type": "object" },
    "started_unix_ms": { "type": "integer", "minimum": 0 },
    "finished_unix_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["completed", "partial_failure", "failed", "cancelled"] },
    "case_journal_sha256": { "$ref": "#/$defs/sha256" },
    "scanner_launch_attempts": { "const": 224 },
    "scanner_processes_attested": { "type": "integer", "minimum": 0, "maximum": 224 },
    "cases": { "type": "array", "minItems": 224, "maxItems": 224, "items": { "type": "object" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
