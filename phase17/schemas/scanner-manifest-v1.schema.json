{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.github.io/secure-bench/schemas/scanner-manifest-v1.schema.json",
  "title": "Secure Bench scanner manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "scanner", "artifact", "ruleset", "capabilities",
    "command_template", "resources", "exit_semantics", "adapter"
  ],
  "properties": {
    "schema_version": { "const": "secure-bench-scanner-manifest-v1" },
    "protocol_version": { "const": "1.0.0" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "upstream_repository", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "upstream_repository": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "name", "operating_system", "architecture", "size_bytes", "sha256", "verification"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme", "signature_url", "signature_sha256", "certificate_url",
            "certificate_sha256", "certificate_issuer", "certificate_identity", "source_revision",
            "verification_command"
          ],
          "properties": {
            "scheme": { "type": "string", "minLength": 1 },
            "signature_url": { "type": "string", "format": "uri" },
            "signature_sha256": { "$ref": "#/$defs/sha256" },
            "certificate_url": { "type": "string", "format": "uri" },
            "certificate_sha256": { "$ref": "#/$defs/sha256" },
            "certificate_issuer": { "type": "string", "format": "uri" },
            "certificate_identity": { "type": "string", "format": "uri" },
            "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "verification_command": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "origin", "license", "sha256", "rule_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "inter_file", "interprocedural", "taint", "qualification"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "frameworks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "inter_file": { "type": "boolean" },
        "interprocedural": { "type": "boolean" },
        "taint": { "type": "boolean" },
        "qualification": { "type": "string", "minLength": 1 }
      }
    },
    "command_template": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_output_bytes", "memory_limit_mib", "process_limit", "network_allowed", "isolated_fixture_copy"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "memory_limit_mib": { "type": "integer", "minimum": 1 },
        "process_limit": { "type": "integer", "minimum": 1 },
        "network_allowed": { "const": false },
        "isolated_fixture_copy": { "const": true }
      }
    },
    "exit_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "findings", "all_other"],
      "properties": {
        "clean": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
        "findings": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
        "all_other": { "type": "string", "minLength": 1 }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_output_format", "adapter_id", "adapter_version"],
      "properties": {
        "raw_output_format": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
