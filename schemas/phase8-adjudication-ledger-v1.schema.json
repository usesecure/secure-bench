{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/schemas/phase8-adjudication-ledger-v1.schema.json",
  "title": "Secure Bench Phase 8 adjudication ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event",
    "adjudication_id",
    "phase7_result_sha256",
    "phase7_ledger_sha256",
    "phase7_report_aggregate_sha256",
    "phase7_raw_report_set_digest",
    "process_status_policy_sha256",
    "previous_entry_hash",
    "case_id",
    "report_sha256",
    "derivation_sha256",
    "result_sha256",
    "entry_hash"
  ],
  "properties": {
    "schema_version": { "const": "secure-bench-phase8-adjudication-ledger-v1" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 113 },
    "event": { "enum": ["adjudication_started", "case_adjudicated", "adjudication_completed"] },
    "adjudication_id": { "const": "phase-8-exit-code-adjudication" },
    "phase7_result_sha256": { "$ref": "#/$defs/sha256" },
    "phase7_ledger_sha256": { "$ref": "#/$defs/sha256" },
    "phase7_report_aggregate_sha256": { "$ref": "#/$defs/sha256" },
    "phase7_raw_report_set_digest": { "$ref": "#/$defs/sha256" },
    "process_status_policy_sha256": { "$ref": "#/$defs/sha256" },
    "previous_entry_hash": { "$ref": "#/$defs/sha256" },
    "case_id": { "type": ["string", "null"] },
    "report_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "derivation_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "result_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "entry_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
