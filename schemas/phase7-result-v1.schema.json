{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/schemas/phase7-result-v1.schema.json",
  "title": "Secure Bench Phase 7 Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "holdout_id", "taxonomy_version", "cases", "findings", "metrics", "breakdowns", "measurement", "semantic_fingerprint", "provenance"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase7-result-v1" },
    "run_id": { "const": "secure-engine-0-1-3-orthogonal-holdout-once" },
    "holdout_id": { "const": "phase-5-orthogonal-holdout-v2" },
    "taxonomy_version": { "const": "1.0.0" },
    "cases": { "type": "array", "minItems": 112, "maxItems": 112, "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "metrics": { "type": "object" },
    "breakdowns": { "type": "object" },
    "measurement": { "type": "object" },
    "semantic_fingerprint": { "$ref": "#/$defs/hash" },
    "provenance": { "type": "object" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
