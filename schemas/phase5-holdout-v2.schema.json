{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/schemas/phase5-holdout-v2.schema.json",
  "title": "Secure Bench Phase 5 Orthogonal Holdout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "holdout_id", "title", "description", "methodology_version", "frozen_at_utc", "git_base", "branch", "taxonomy", "evidence_contract", "design", "design_sources", "commitments", "protocol", "creation", "historical_integrity", "pairs"],
  "properties": {
    "schema_version": { "const": "secure-bench-orthogonal-holdout-v2" },
    "holdout_id": { "const": "phase-5-orthogonal-holdout-v2" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "methodology_version": { "const": "5.0.0" },
    "frozen_at_utc": { "type": "string", "format": "date-time" },
    "git_base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "branch": { "const": "codex/phase-5-orthogonal-holdout-v2" },
    "taxonomy": { "type": "object" },
    "evidence_contract": { "type": "object" },
    "design": { "type": "object" },
    "design_sources": { "type": "array", "minItems": 13, "uniqueItems": true },
    "commitments": { "type": "object" },
    "protocol": { "type": "object" },
    "creation": { "type": "object" },
    "historical_integrity": { "type": "object" },
    "pairs": { "type": "array", "minItems": 56, "maxItems": 56 }
  }
}
