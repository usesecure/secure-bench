{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secure-bench/schemas/phase4-run-v1.schema.json",
  "title": "Secure Bench Phase 4 Retained Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "holdout_id", "pre_execution_contract_sha256", "binary_sha256", "source_rpm_sha256", "command_template", "ai_validation", "version_probe_executed", "isolation", "host", "started_unix_ms", "finished_unix_ms", "status", "case_journal_sha256", "cases"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase4-run-v1" }, "run_id": { "const": "secure-engine-0-1-2-holdout-once" }, "holdout_id": { "type": "string", "minLength": 1 },
    "pre_execution_contract_sha256": { "$ref": "#/$defs/sha256" }, "binary_sha256": { "$ref": "#/$defs/sha256" }, "source_rpm_sha256": { "$ref": "#/$defs/sha256" },
    "command_template": { "const": ["scan", "{fixture}", "--format", "secure-json-v1", "--output", "{report}"] }, "ai_validation": { "const": "disabled" }, "version_probe_executed": { "const": false },
    "isolation": { "type": "object" }, "host": { "type": "object" }, "started_unix_ms": { "type": "integer", "minimum": 0 }, "finished_unix_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["completed", "partial_failure", "failed", "cancelled"] }, "case_journal_sha256": { "$ref": "#/$defs/sha256" },
    "cases": { "type": "array", "minItems": 56, "maxItems": 56, "items": { "type": "object" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
