{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/schemas/phase7-run-v1.schema.json",
  "title": "Secure Bench Phase 7 Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "holdout_id", "pre_execution_contract_sha256", "binary_sha256", "source_rpm_sha256", "command_template", "ai_validation", "version_probe_executed", "host", "started_unix_ms", "finished_unix_ms", "status", "case_journal_sha256", "cases"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase7-run-v1" },
    "run_id": { "const": "secure-engine-0-1-3-orthogonal-holdout-once" },
    "holdout_id": { "const": "phase-5-orthogonal-holdout-v2" },
    "pre_execution_contract_sha256": { "$ref": "#/$defs/hash" },
    "binary_sha256": { "$ref": "#/$defs/hash" },
    "source_rpm_sha256": { "$ref": "#/$defs/hash" },
    "command_template": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } },
    "ai_validation": { "type": "string", "pattern": "^disabled" },
    "version_probe_executed": { "const": false },
    "host": { "type": "object" },
    "started_unix_ms": { "type": "integer", "minimum": 0 },
    "finished_unix_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["completed", "partial_failure", "failed", "cancelled"] },
    "case_journal_sha256": { "$ref": "#/$defs/hash" },
    "cases": { "type": "array", "minItems": 112, "maxItems": 112, "items": { "type": "object" } }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
