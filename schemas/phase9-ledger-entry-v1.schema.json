{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/schemas/phase9-ledger-entry-v1.schema.json",
  "title": "Secure Bench Phase 9 append-only ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event",
    "holdout_id",
    "manifest_sha256",
    "evidence_contract_sha256",
    "taxonomy_sha256",
    "aggregate_corpus_sha256",
    "commitment_root",
    "previous_entry_hash",
    "timestamp_utc",
    "entry_hash"
  ],
  "properties": {
    "schema_version": { "const": "secure-bench-phase9-ledger-entry-v1" },
    "sequence": { "const": 0 },
    "event": { "const": "holdout_frozen" },
    "holdout_id": { "const": "phase-9-orthogonal-holdout-v3" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_contract_sha256": { "$ref": "#/$defs/sha256" },
    "taxonomy_sha256": { "$ref": "#/$defs/sha256" },
    "aggregate_corpus_sha256": { "$ref": "#/$defs/sha256" },
    "commitment_root": { "$ref": "#/$defs/sha256" },
    "previous_entry_hash": { "$ref": "#/$defs/sha256" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "entry_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
