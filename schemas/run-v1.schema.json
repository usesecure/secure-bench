{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secure-bench/schemas/run-v1.schema.json",
  "title": "Secure Bench Recorded Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "adapter", "report_path", "tool", "host", "case_executions"],
  "properties": {
    "schema_version": { "const": "secure-bench-run-v1" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "adapter": { "enum": ["secure-json-v1", "sarif210", "unsupported"] },
    "report_path": { "type": "string", "minLength": 1 },
    "tool": { "$ref": "#/$defs/tool" },
    "host": { "$ref": "#/$defs/host" },
    "case_executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 0 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command", "configuration_fingerprint", "report_schema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "configuration_fingerprint": { "$ref": "#/$defs/sha256" },
        "report_schema": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "logical_cpus", "memory_bytes"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "logical_cpus": { "type": ["integer", "null"], "minimum": 1 },
        "memory_bytes": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "cold_duration_ms", "warm_duration_ms", "peak_memory_bytes", "output_bytes"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["success", "crash", "timeout", "unsupported", "missing", "parse_failure"] },
        "cold_duration_ms": { "$ref": "#/$defs/nullablePositiveInteger" },
        "warm_duration_ms": { "$ref": "#/$defs/nullablePositiveInteger" },
        "peak_memory_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
        "output_bytes": { "$ref": "#/$defs/nullablePositiveInteger" }
      }
    }
  }
}
