{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secure-bench/schemas/holdout-ledger-entry-v1.schema.json",
  "title": "Secure Bench Holdout Append-Only Ledger Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event",
    "holdout_id",
    "commitment_root",
    "previous_entry_hash",
    "timestamp_utc",
    "run_id",
    "binary_sha256",
    "result_sha256",
    "detail_code",
    "entry_hash"
  ],
  "properties": {
    "schema_version": { "const": "secure-bench-holdout-ledger-entry-v1" },
    "sequence": { "type": "integer", "minimum": 0 },
    "event": { "enum": ["holdout_sealed", "execution_started", "execution_completed", "execution_failed"] },
    "holdout_id": { "const": "phase-3-expanded-frozen-holdout" },
    "commitment_root": { "$ref": "#/$defs/sha256" },
    "previous_entry_hash": { "$ref": "#/$defs/sha256" },
    "timestamp_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+$" },
    "binary_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "result_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "detail_code": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "entry_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
