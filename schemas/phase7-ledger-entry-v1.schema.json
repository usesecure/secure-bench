{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/schemas/phase7-ledger-entry-v1.schema.json",
  "title": "Secure Bench Phase 7 Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event", "holdout_id", "run_id", "manifest_sha256", "evidence_contract_sha256", "commitment_root", "binary_sha256", "previous_entry_hash", "timestamp_utc", "case_id", "case_status", "case_record_sha256", "report_sha256", "result_sha256", "failure_code", "entry_hash"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase7-ledger-entry-v1" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 114 },
    "event": { "enum": ["execution_started", "case_recorded", "execution_completed", "execution_failed"] },
    "holdout_id": { "const": "phase-5-orthogonal-holdout-v2" },
    "run_id": { "const": "secure-engine-0-1-3-orthogonal-holdout-once" },
    "manifest_sha256": { "$ref": "#/$defs/hash" },
    "evidence_contract_sha256": { "$ref": "#/$defs/hash" },
    "commitment_root": { "$ref": "#/$defs/hash" },
    "binary_sha256": { "$ref": "#/$defs/hash" },
    "previous_entry_hash": { "$ref": "#/$defs/hash" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "case_id": { "type": ["string", "null"] },
    "case_status": { "type": ["string", "null"] },
    "case_record_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "report_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "result_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "failure_code": { "type": ["string", "null"] },
    "entry_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
