{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secure-bench/schemas/suite-v2.schema.json",
  "title": "Secure Bench First-Party Corpus Suite v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "title", "description", "methodology_version", "corpus_fingerprint", "provenance", "cases"],
  "properties": {
    "schema_version": { "const": "secure-bench-suite-v2" },
    "suite_id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "methodology_version": { "type": "string", "minLength": 1 },
    "corpus_fingerprint": { "$ref": "#/$defs/sha256" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "cases": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:%\\\\]).+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license", "revision", "modifications", "authors"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "modifications": { "type": "string" },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "kind", "language", "framework", "category", "invariant", "fixture_path", "content_fingerprint", "eligibility", "resource_budget", "expected_findings", "provenance"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["vulnerable", "safe_control"] },
        "language": { "enum": ["javascript", "jsx", "typescript", "tsx"] },
        "framework": { "enum": ["Node.js", "Express", "Next.js"] },
        "category": { "enum": ["command-execution", "raw-sql-construction", "filesystem-boundary", "outbound-request-boundary", "redirect-boundary", "dynamic-code-execution", "authorization-dominance"] },
        "invariant": { "type": ["string", "null"] },
        "fixture_path": { "$ref": "#/$defs/relativePath" },
        "content_fingerprint": { "$ref": "#/$defs/sha256" },
        "eligibility": { "$ref": "#/$defs/eligibility" },
        "resource_budget": { "$ref": "#/$defs/resourceBudget" },
        "expected_findings": { "type": "array", "items": { "$ref": "#/$defs/expectation" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "vulnerable" } } },
          "then": { "properties": { "invariant": { "type": "string", "minLength": 1 }, "expected_findings": { "minItems": 1 } } },
          "else": { "properties": { "invariant": { "type": "null" }, "expected_findings": { "maxItems": 0 } } }
        }
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_capabilities", "supported_report_formats", "rationale"],
      "properties": {
        "required_capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "supported_report_formats": { "type": "array", "contains": { "const": "secure-json-v1" }, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "resourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "memory_bytes", "output_bytes", "network"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "output_bytes": { "type": "integer", "minimum": 1 },
        "network": { "const": "disabled" }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation_id", "invariant", "category", "severity", "confidence", "source", "sink", "evidence"],
      "properties": {
        "expectation_id": { "$ref": "#/$defs/identifier" },
        "invariant": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "source": { "$ref": "#/$defs/locationConstraint" },
        "sink": { "$ref": "#/$defs/locationConstraint" },
        "evidence": { "$ref": "#/$defs/evidenceConstraint" }
      }
    },
    "locationConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "alternatives"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/locationVariant" } }
      }
    },
    "locationVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": { "path": { "$ref": "#/$defs/relativePath" }, "line": { "type": ["integer", "null"], "minimum": 1 } }
    },
    "evidenceConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_hops", "required_kinds"],
      "properties": {
        "minimum_hops": { "type": "integer", "minimum": 2 },
        "required_kinds": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
