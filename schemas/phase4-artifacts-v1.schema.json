{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/secure-bench/schemas/phase4-artifacts-v1.schema.json",
  "title": "Secure Bench Phase 4 Artifact Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "pre_execution_contract_path", "pre_execution_contract_sha256", "run_path", "run_sha256", "result_path", "result_sha256", "ledger_path", "ledger_sha256", "reports_sha256", "report_count"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase4-artifacts-v1" }, "run_id": { "const": "secure-engine-0-1-2-holdout-once" },
    "pre_execution_contract_path": { "$ref": "#/$defs/path" }, "pre_execution_contract_sha256": { "$ref": "#/$defs/sha256" }, "run_path": { "$ref": "#/$defs/path" }, "run_sha256": { "$ref": "#/$defs/sha256" },
    "result_path": { "$ref": "#/$defs/path" }, "result_sha256": { "$ref": "#/$defs/sha256" }, "ledger_path": { "$ref": "#/$defs/path" }, "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "reports_sha256": { "$ref": "#/$defs/sha256" }, "report_count": { "type": "integer", "minimum": 0, "maximum": 56 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "path": { "type": "string", "minLength": 1, "pattern": "^[^/]" } }
}
