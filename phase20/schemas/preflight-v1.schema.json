{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-bench.invalid/phase20/preflight-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "verified_at_unix_ms", "phase19_commit", "aggregate_corpus_sha256", "contract_merkle_root", "implementation_sha256", "verified", "case_count", "eligible_lanes", "scanner_process_attempts_before_opening", "policy"],
  "properties": {
    "schema_version": {"const": "secure-bench-phase20-preflight-v1"},
    "verified_at_unix_ms": {"type": "integer", "minimum": 1},
    "phase19_commit": {"pattern": "^[0-9a-f]{40}$"},
    "aggregate_corpus_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "contract_merkle_root": {"pattern": "^[0-9a-f]{64}$"},
    "implementation_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "verified": {"type": "object", "minProperties": 13, "additionalProperties": {"type": "string"}},
    "case_count": {"const": 112},
    "eligible_lanes": {"const": 3},
    "scanner_process_attempts_before_opening": {"const": 0},
    "policy": {"type": "object"}
  },
  "additionalProperties": false
}
