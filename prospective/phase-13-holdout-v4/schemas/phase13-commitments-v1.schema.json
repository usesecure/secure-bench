{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usesecure.dev/schemas/phase13-commitments-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "holdout_id", "manifest_sha256", "expectations_sha256", "aggregate_corpus_sha256", "contract_merkle_root", "evaluator_sha256", "genesis_ledger_sha256", "fixture_files"],
  "properties": {
    "schema_version": { "const": "secure-bench-phase13-commitments-v1" },
    "holdout_id": { "const": "secure-bench-phase13-holdout-v4" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "expectations_sha256": { "$ref": "#/$defs/sha256" },
    "aggregate_corpus_sha256": { "$ref": "#/$defs/sha256" },
    "contract_merkle_root": { "$ref": "#/$defs/sha256" },
    "evaluator_sha256": { "$ref": "#/$defs/sha256" },
    "genesis_ledger_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_files": { "type": "object", "minProperties": 112, "additionalProperties": { "$ref": "#/$defs/sha256" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
